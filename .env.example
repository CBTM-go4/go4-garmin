# Copy to .env and adjust. All values are optional.

# --- Demo mode: run the whole dashboard on synthetic data (no Garmin needed) ---
# GARMIN_COACH_DEMO=1

# --- Server ---
# GARMIN_COACH_HOST=127.0.0.1
# GARMIN_COACH_PORT=8765

# --- Athlete constants used by the training-load / zone math ---
# If unset, HR max is inferred from your data and HR rest defaults to 48.
# GARMIN_COACH_HR_MAX=188
# GARMIN_COACH_HR_REST=46

# --- Garmin MCP server launch override (advanced) ---
# By default the backend launches the Taxuspt garmin_mcp server via uvx.
# Point this at a local checkout if you prefer:
# GARMIN_MCP_CMD=uv run --directory C:/path/to/garmin_mcp garmin-mcp

# --- Garmin credentials (usually NOT needed here) ---
# Preferred auth is the one-time interactive `garmin-mcp-auth` (handles MFA),
# which saves a token to ~/.garminconnect. Only set these for headless/no-MFA use:
# GARMIN_EMAIL=you@example.com
# GARMIN_PASSWORD=...
# GARMIN_IS_CN=false
